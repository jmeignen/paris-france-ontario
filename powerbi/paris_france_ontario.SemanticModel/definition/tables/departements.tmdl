table departements
	lineageTag: b573e561-fc5c-466e-b173-50d27de2a8c4

	measure 'Densité de parieurs' = DIVIDE(SUM(departements[parieurs]), SUM(departements[adultes]))
		formatString: 0.0%
		lineageTag: 542a605c-4f56-4393-8f35-5b7055e7e4e9

	measure 'Hommes 20-34 ans' = AVERAGE(departements[part_hommes_20_34])
		formatString: 0.0%
		lineageTag: 7c193c33-fd93-4825-892d-2415ebbeca81

	measure 'Pauvreté (%)' = AVERAGE(departements[pauvrete])
		formatString: 0.0
