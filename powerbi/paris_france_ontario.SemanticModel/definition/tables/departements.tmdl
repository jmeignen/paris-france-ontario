	partition departements = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\donnees\exports\france_departements.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Kept = Table.SelectColumns(Promoted, {"dep", "departement", "parieurs", "adultes", "niveau_vie", "pauvrete", "part_hommes_20_34", "densite_paris"}),
				    Renamed = Kept,
				    Typed = Table.TransformColumnTypes(Renamed, {{"dep", type text}, {"departement", type text}, {"parieurs", Int64.Type}, {"adultes", Int64.Type}, {"niveau_vie", type number}, {"pauvrete", type number}, {"part_hommes_20_34", type number}, {"densite_paris", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

