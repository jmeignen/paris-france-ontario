table suivi_ontario
	lineageTag: 596a918f-a552-48dd-91fb-0c720f858e6b

	measure 'Marge du mois' = SUM(suivi_ontario[marge])
		formatString: 0.0%
		lineageTag: fdfd79ba-a565-43dc-894a-c4b5646ed61a

	measure 'Limite basse' = SUM(suivi_ontario[limite_basse])
		formatString: 0.0%
		lineageTag: 021ad27f-2462-4c77-bb9b-37e7a8e7467a

	measure 'Limite haute' = SUM(suivi_ontario[limite_haute])
		formatString: 0.0%
		lineageTag: 451efd9f-42e7-4e2e-94cb-7de6e639c934

	measure 'Mois à expliquer' = CALCULATE(COUNTROWS(suivi_ontario), suivi_ontario[statut] = "Écart à expliquer")
