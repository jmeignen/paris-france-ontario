	partition suivi_ontario = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\donnees\exports\suivi_ontario_paris_mensuel.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Kept = Table.SelectColumns(Promoted, {"mois", "mises_m", "revenu_m", "marge", "moyenne_12m", "limite_basse", "limite_haute", "statut"}),
				    Renamed = Kept,
				    Typed = Table.TransformColumnTypes(Renamed, {{"mois", type date}, {"mises_m", type number}, {"revenu_m", type number}, {"marge", type number}, {"moyenne_12m", type number}, {"limite_basse", type number}, {"limite_haute", type number}, {"statut", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

