	partition evenements = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\donnees\exports\evenements_reglementaires.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Kept = Table.SelectColumns(Promoted, {"date", "marche", "evenement", "source"}),
				    Renamed = Kept,
				    Typed = Table.TransformColumnTypes(Renamed, {{"date", type date}, {"marche", type text}, {"evenement", type text}, {"source", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

