table interdits
	lineageTag: 712fa676-854f-4add-84e5-4ecc02b6a1cb

	measure Interdits = SUM(interdits[inscrits])
		formatString: #,0
		lineageTag: 679075c3-8795-44e5-9f3d-085c9b8aa020

	measure 'Nouvelles inscriptions' = SUM(interdits[entrees])
		formatString: #,0
		lineageTag: 603eb184-f0cf-4aa1-ba06-47323105257d

	column annee
		dataType: int64
		sourceColumn: annee
		lineageTag: 90d18665-c4ae-4b41-9243-42b6105aa457
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column inscrits
		dataType: int64
		formatString: #,0
		sourceColumn: inscrits
		lineageTag: 89b91b38-1166-43cd-90bf-e14864dc7531
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column entrees
		dataType: int64
		formatString: #,0
		sourceColumn: entrees
		lineageTag: 3657f921-a397-4a61-b6fe-099cdf4e3134
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column sorties
		dataType: int64
		formatString: #,0
		sourceColumn: sorties
		lineageTag: 30b852bb-a7a0-4e25-bfd7-83b0ff7fa96b
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition interdits = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\donnees\exports\france_interdits_annuel.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Kept = Table.SelectColumns(Promoted, {"annee", "inscrits", "entrees", "sorties"}),
				    Renamed = Kept,
				    Typed = Table.TransformColumnTypes(Renamed, {{"annee", Int64.Type}, {"inscrits", Int64.Type}, {"entrees", Int64.Type}, {"sorties", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

